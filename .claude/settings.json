{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "model": "opus",
    "effortLevel": "medium",
    "language": "French",
    "permissions": {
        "defaultMode": "plan",
        "allow": [
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(npm run:*)",
            "Bash(npm test:*)",
            "Bash(npm install)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git merge:*)",
            "Bash(git rebase:*)",
            "Bash(npm install :*)",
            "Bash(npm add:*)",
            "Bash(npx:*)",
            "Bash(pnpm dlx:*)",
            "Bash(yarn dlx:*)",
            "Bash(bunx:*)"
        ],
        "deny": [
            "Bash(git reset --hard:*)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git clean -f:*)",
            "Bash(git branch -D:*)",
            "Bash(rm -rf /:*)",
            "Bash(rm -rf ~:*)",
            "Read(./.env)",
            "Read(./**/.env)",
            "Read(./.env.local)",
            "Read(./**/.env.local)",
            "Read(./.env.*.local)",
            "Read(./**/.env.*.local)",
            "Read(./.env.development)",
            "Read(./**/.env.development)",
            "Read(./.env.production)",
            "Read(./**/.env.production)",
            "Read(./.env.test)",
            "Read(./**/.env.test)",
            "Read(./.env.staging)",
            "Read(./**/.env.staging)",
            "Read(./**/*.pem)",
            "Read(./**/*.key)",
            "Read(./package-lock.json)",
            "Read(./pnpm-lock.yaml)",
            "Read(./yarn.lock)",
            "Read(./bun.lock)",
            "Read(./bun.lockb)",
            "Read(./.git/**)",
            "Read(./**/*.map)",
            "Read(./**/*.min.js)",
            "Edit(./.env)",
            "Edit(./**/.env)",
            "Edit(./.env.local)",
            "Edit(./**/.env.local)",
            "Edit(./.env.*.local)",
            "Edit(./**/.env.*.local)",
            "Edit(./.env.development)",
            "Edit(./**/.env.development)",
            "Edit(./.env.production)",
            "Edit(./**/.env.production)",
            "Edit(./.env.test)",
            "Edit(./**/.env.test)",
            "Edit(./.env.staging)",
            "Edit(./**/.env.staging)",
            "Edit(./**/*.pem)",
            "Edit(./**/*.key)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-node.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\""
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-node.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\""
                    }
                ]
            }
        ]
    }
}
