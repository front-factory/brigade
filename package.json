{
    "name": "@frontfactory/brigade",
    "version": "1.6.2",
    "description": "Claude Code, organized like a kitchen brigade.",
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "test": "node --test \"test/*.test.js\"",
        "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
        "release": "semantic-release"
    },
    "engines": {
        "node": ">=24"
    },
    "bin": {
        "brigade": "bin/brigade.js"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "husky": "^9.1.7",
        "semantic-release": "^25.0.9"
    },
    "dependencies": {
        "@clack/prompts": "^1.8.1"
    },
    "keywords": [
        "claude-code",
        "claude",
        "cli",
        "scaffold",
        "git-hooks"
    ],
    "license": "MIT",
    "homepage": "https://github.com/front-factory/brigade#readme",
    "bugs": {
        "url": "https://github.com/front-factory/brigade/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/front-factory/brigade.git"
    },
    "files": [
        "bin",
        "src",
        "templates"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
